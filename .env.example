PORT=3000

# Metadata Providers
TMDB_API_KEY=your_tmdb_api_key
GOOGLE_BOOKS_KEY=your_google_books_key
# Music metadata comes from Deezer's public search API (no key required)

# Client Config
DISCORD_CLIENT_ID=your_discord_application_id

# Security & Versioning
# Options: "LOG_ONLY" (Passive) or "STRICT" (Enforce rules & rate limits)
SECURITY_MODE=LOG_ONLY
LATEST_CLIENT_VERSION=2.4.0
# Max metadata requests per client per minute in STRICT mode (default 20)
RATE_LIMIT_MAX=20
